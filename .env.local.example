# JZL CLOSET 환경변수 예시 — 값은 비워 두었습니다.
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 깃에 올라가지 않습니다)

# ── Supabase ──────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 절대 클라이언트로 노출하지 마세요. 서버에서만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (상품 이미지 저장소) ─────────────────────
# Cloudflare 대시보드 > R2 > Manage R2 API Tokens 에서 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 버킷의 공개 URL (예: https://pub-xxxx.r2.dev 또는 연결한 커스텀 도메인)
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── 관리자 ────────────────────────────────────────────────
# /admin 로그인 비밀번호. 관리자 쿠키 서명 키로도 쓰이므로 길고 복잡하게 설정하세요.
ADMIN_PASSWORD=

# ── 손님 주문 토큰 서명 키 ─────────────────────────────────
# 주문 완료 화면(/checkout/complete?no=&k=)과 결제 상태 확인 창구를 여는
# 서명값을 만드는 데 씁니다. 손님만 쓰는 키입니다.
#
# ★★ 왜 ADMIN_PASSWORD 와 따로 두는가
#   예전에는 이 서명에도 ADMIN_PASSWORD 를 썼습니다. 그래서 관리자 비밀번호를
#   바꾸면 그때까지 발급된 손님 토큰이 전부 무효가 되고, 결제를 막 끝낸 손님이
#   완료 화면을 못 열었습니다. (토큰 수명이 6시간이라 최대 6시간짜리 여파)
#   관리자 비밀번호를 바꾸는 일이 손님 결제를 건드리면 안 되므로 뗐습니다.
#
# ★ 비워 두면 지금까지처럼 ADMIN_PASSWORD 를 씁니다. 동작이 바뀌지 않습니다.
# ★ 값 만드는 법 — 아무 의미 없는 긴 무작위 문자열이면 됩니다.
#     openssl rand -hex 32
#   또는 1Password·Bitwarden 같은 비밀번호 관리자의 "무작위 생성" 64자.
#   사람이 외울 필요가 전혀 없는 값입니다. 어디에도 다시 입력하지 않습니다.
# ★★ 한 번 정하면 바꾸지 마세요. 바꾸면 그 순간 손님 토큰이 무효가 됩니다.
ORDER_TOKEN_SECRET=

# ── 텔레그램 주문 알림 ─────────────────────────────────────
# 새 주문과 취소 요청을 텔레그램으로 받습니다.
# 두 값이 비어 있으면 알림만 건너뛰고 주문은 정상 저장됩니다.
#
# 받는 방법
#   1) 텔레그램에서 @BotFather 에게 /newbot → 토큰을 받습니다 (TELEGRAM_BOT_TOKEN)
#   2) 만들어진 봇과 대화를 한 번 시작합니다 (아무 메시지나 전송)
#   3) https://api.telegram.org/bot<토큰>/getUpdates 를 열어 chat.id 를 확인합니다 (TELEGRAM_CHAT_ID)
#   4) 관리자 > 설정 > 결제·주문 에서 알림 사용 토글을 켭니다
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── KSNET 카드결제 (4-A) ───────────────────────────────────
# 신용카드 · 카카오페이 · 네이버페이 결제에 씁니다.
#
# ★ 기본값은 테스트입니다. 두 값을 넣지 않으면 테스트 상점아이디(2999199999)로
#   동작하며 실제 돈이 오가지 않습니다. 테스트 결제는 수 초 뒤 자동 취소됩니다.
#
# ★ 운영으로 바꾸는 방법 (반드시 두 값을 함께 바꿔야 합니다)
#     KSNET_MID  = 2074300026   (운영 상점아이디)
#     KSNET_MODE = live
#   KSNET_MODE 를 live 로 두고 KSNET_MID 를 비워 두면 결제창이 열리지 않습니다.
#   (테스트 아이디로 운영 결제가 나가는 사고를 막기 위해 일부러 막아 두었습니다)
#
# ★ 확인 사항
#   테스트 아이디로는 국민카드와 계좌이체를 테스트할 수 없습니다.
#   거래 확인은 https://ksta.ksnet.co.kr (접속 계정은 영업담당자 문의)
KSNET_MID=
KSNET_MODE=test
