{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/auto-cancel",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/card-sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/card-daily",
      "schedule": "50 14 * * *"
    }
  ]
}
